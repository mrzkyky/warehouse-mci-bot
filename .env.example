# =====================================
# WAREHOUSE BOT CONFIGURATION
# =====================================

# REQUIRED: Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# REQUIRED: Your Telegram User ID (get from @userinfobot)
# Can be multiple admins separated by comma
ADMIN_IDS=123456789,987654321

# Database Configuration
# SQLite (default - for development/single user)
DATABASE_URL=sqlite:///data/warehouse.db

# PostgreSQL (for production/multi-user) - Uncomment to use
# DATABASE_URL=postgresql+asyncpg://warehouse:password@db:5432/warehouse

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract

# Report Settings
REPORT_TIMEZONE=Asia/Jakarta
COMPANY_NAME=PT Rapid Network

# Optional: Webhook mode (for production instead of polling)
# USE_WEBHOOK=false
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=/webhook
# WEBHOOK_URL=https://yourdomain.com/webhook
